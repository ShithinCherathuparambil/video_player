import 'dart:async';
import 'dart:io';
import 'package:flutter/foundation.dart';
import 'package:lumeo/core/error/exceptions.dart';
import 'package:lumeo/core/security/path_validator.dart';
import 'package:lumeo/domain/entities/video_file.dart';
import 'package:path_provider/path_provider.dart';
import 'package:video_thumbnail/video_thumbnail.dart';
import 'package:video_player/video_player.dart';
import 'package:path/path.dart' as path;
import 'package:photo_manager/photo_manager.dart';
import 'package:lumeo/core/services/permission_service.dart';

abstract class VideoLocalDataSource {
  Future<List<VideoFile>> getVideos({int page = 0, int pageSize = 20});
  Future<void> requestPermissions();
  Future<void> deleteVideo(String videoPath);
  Future<int> getTotalVideoCount();
}

class PermissionDeniedException implements Exception {
  final String message;
  PermissionDeniedException(this.message);
  @override
  String toString() => 'PermissionDeniedException: $message';
}

class VideoLocalDataSourceImpl implements VideoLocalDataSource {
  VideoLocalDataSourceImpl({
    required PathValidator pathValidator,
    required PermissionService permissionService,
  })  : _pathValidator = pathValidator,
        _permissionService = permissionService;

  final PathValidator _pathValidator;
  final PermissionService _permissionService;
  final Map<String, String> _thumbnailCache = {};
  final Map<String, Duration> _durationCache = {};
  final Map<String, VideoPlayerController> _controllerCache = {};

  @override
  Future<void> requestPermissions() async {
    try {
      final permissionState = await _permissionService.requestPhotoPermission();
      if (!permissionState.isGranted) {
        throw PermissionException('Photo/Video permission denied');
      }
    } catch (e) {
      throw PermissionException('Failed to request permissions: ${e.toString()}');
    }
  }

  @override
  Future<List<VideoFile>> getVideos({int page = 0, int pageSize = 20}) async {
    try {
      final permissionState = await _permissionService.checkPhotoPermission();
      if (!permissionState.isGranted) {
        await requestPermissions();
      }

      final List<AssetPathEntity> paths = await PhotoManager.getAssetPathList(
        onlyAll: true,
        type: RequestType.video,
      );

      if (paths.isEmpty) {
        debugPrint('No video paths found');
        return [];
      }

      final assetPath = paths.first;
      final List<AssetEntity> assets = await assetPath.getAssetListPaged(
        page: page,
        size: pageSize,
      );

      final List<VideoFile> videos = [];
      for (final asset in assets) {
        try {
          final file = await asset.file;
          if (file != null && await file.exists()) {
            final String filePath = file.path;
            if (_pathValidator.isPathValid(filePath)) {
              final videoFile = await _createVideoFile(file, asset);
              if (videoFile != null) {
                videos.add(videoFile);
              }
            }
          } else {
            debugPrint('Skipped file: ${file?.path} (invalid or null)');
            continue;
          }
        } catch (e) {
          debugPrint('Error processing video asset: $e');
          continue;
        }
      }

      return videos;
    } catch (e) {
      throw CacheException('Failed to fetch videos: ${e.toString()}');
    }
  }

  Future<VideoFile?> _createVideoFile(File file, AssetEntity asset) async {
    try {
      final String filePath = file.path;
      final String fileName = path.basename(filePath);
      final DateTime modifiedDate = await file.lastModified();
      final int fileSize = await file.length();

      final Duration duration = await _getVideoDuration(filePath);
      final String? thumbnail = await _generateThumbnail(filePath);

      if (thumbnail == null) {
        debugPrint('Failed to generate thumbnail for: $filePath');
        return null;
      }

      return VideoFile(
        name: fileName,
        path: filePath,
        size: fileSize,
        modifiedDate: modifiedDate,
        duration: duration,
        thumbnail: thumbnail,
      );
    } catch (e) {
      debugPrint('Error creating VideoFile object: $e');
      return null;
    }
  }

  Future<Duration> _getVideoDuration(String filePath) async {
    if (_durationCache.containsKey(filePath)) {
      return _durationCache[filePath]!;
    }

    try {
      VideoPlayerController? controller = _controllerCache[filePath];
      if (controller == null || !controller.value.isInitialized) {
        controller = VideoPlayerController.file(File(filePath));
        await controller.initialize();
        _controllerCache[filePath] = controller;
      }

      final duration = controller.value.duration;
      _durationCache[filePath] = duration;
      return duration;
    } catch (e) {
      debugPrint('Error getting video duration: $e');
      return Duration.zero;
    }
  }

  Future<String?> _generateThumbnail(String videoPath) async {
    if (_thumbnailCache.containsKey(videoPath)) {
      return _thumbnailCache[videoPath];
    }

    try {
      final tempDir = await getTemporaryDirectory();
      final thumbnailPath = path.join(
        tempDir.path,
        'thumbnails',
        '${path.basenameWithoutExtension(videoPath)}_thumb.jpg',
      );

      // Create thumbnails directory if it doesn't exist
      await Directory(path.dirname(thumbnailPath)).create(recursive: true);

      final String? generatedThumbnail = await VideoThumbnail.thumbnailFile(
        video: videoPath,
        thumbnailPath: thumbnailPath,
        imageFormat: ImageFormat.JPEG,
        quality: 75,
      );

      if (generatedThumbnail != null) {
        _thumbnailCache[videoPath] = generatedThumbnail;
        return generatedThumbnail;
      }
      return null;
    } catch (e) {
      debugPrint('Error generating thumbnail: $e');
      return null;
    }
  }

  @override
  Future<void> deleteVideo(String videoPath) async {
    try {
      if (!_pathValidator.isPathValid(videoPath)) {
        throw InvalidPathException('Invalid video path');
      }

      final file = File(videoPath);
      if (await file.exists()) {
        await file.delete();
        
        // Clean up caches
        _thumbnailCache.remove(videoPath);
        _durationCache.remove(videoPath);
        if (_controllerCache.containsKey(videoPath)) {
          await _controllerCache[videoPath]?.dispose();
          _controllerCache.remove(videoPath);
        }

        // Clean up thumbnail file
        final tempDir = await getTemporaryDirectory();
        final thumbnailPath = path.join(
          tempDir.path,
          'thumbnails',
          '${path.basenameWithoutExtension(videoPath)}_thumb.jpg',
        );
        final thumbnailFile = File(thumbnailPath);
        if (await thumbnailFile.exists()) {
          await thumbnailFile.delete();
        }
      }
    } catch (e) {
      throw CacheException('Failed to delete video: ${e.toString()}');
    }
  }

  @override
  Future<int> getTotalVideoCount() async {
    try {
      final permissionState = await _permissionService.checkPhotoPermission();
      if (!permissionState.isGranted) {
        await requestPermissions();
      }

      final List<AssetPathEntity> paths = await PhotoManager.getAssetPathList(
        onlyAll: true,
        type: RequestType.video,
      );

      if (paths.isEmpty) return 0;

      final assetPath = paths.first;
      return await assetPath.assetCount;
    } catch (e) {
      throw CacheException('Failed to get video count: ${e.toString()}');
    }
  }

  void dispose() {
    for (final controller in _controllerCache.values) {
      controller.dispose();
    }
    _controllerCache.clear();
  }
}
